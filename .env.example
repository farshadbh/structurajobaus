# Canonical host, e.g. https://phdcompass.com (Render's own address is used until it is set).
NEXT_PUBLIC_SITE_URL=
# Where corrections and privacy requests go. Without it, links point to the GitHub issue tracker.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Accounts ----------------------------------------------------------------
# All three are required for sign-in to work. Without them the account pages
# show a setup notice and every other page on the board is unaffected.

# Upstash Redis, REST API (free tier: 256 MB, 10k commands/day).
# https://console.upstash.com -> create a Redis database -> REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the session cookie (HMAC-SHA256). Any long random string, e.g.
#   openssl rand -hex 32
# Changing it signs everybody out.
AUTH_SECRET=

# --- Professor finder (/professors) ----------------------------------------
# OpenAlex API key - free, but required: requests without one share a small
# daily budget per IP address, which a hosted server exhausts within the day.
# Get one at https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Brave Search API (free tier) finds each professor's staff page on the
# university's own site. Without it, only links listed on ORCID are used.
BRAVE_SEARCH_API_KEY=
# Claude for paid members: reads the CV into research keywords, scores
# professors with a reason, and reads staff pages. Leave empty to offer only
# the private in-browser matching.
ANTHROPIC_API_KEY=
CLAUDE_MATCHES_PER_DAY=15

# --- Membership (Stripe) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PRO_PRICE_LABEL=A$19 / month
# Comma-separated emails treated as members without paying (owner, testers).
PRO_EMAILS=
# Keys in Upstash are prefixed so this site can share a database with the job board.
STORE_KEY_PREFIX=compass:
