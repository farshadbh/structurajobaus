# Canonical host used for canonical tags, sitemap, robots and Open Graph.
# Points at the live Vercel deployment until a custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://structuraljobaus.vercel.app

# Adzuna API credentials — https://developer.adzuna.com
# Used only by scripts/ingest-jobs.mjs. Add the same names as GitHub Actions
# secrets so the 6am refresh can run.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Set to 1 to render the bundled demo listings before the first real sync.
# Never enable this in production.
NEXT_PUBLIC_DEMO_JOBS=0
